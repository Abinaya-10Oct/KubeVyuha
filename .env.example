# KubeVyuha Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control!

# Operating mode: "auto", "live", or "demo"
# auto: attempts to detect kubectl/velero; falls back to demo mode if unavailable
KUBEVYUHA_MODE=auto

# Kubernetes configuration
# Path to kubeconfig if not using standard ~/.kube/config
KUBECONFIG=

# Target Kubernetes Context (safety check)
# Execution will be aborted if current context does not match
KUBEVYUHA_ALLOWED_CONTEXT=kind-kubevyuha-lab

# Velero Namespace and CLI path
VELERO_NAMESPACE=velero
VELERO_BIN=velero
KUBECTL_BIN=kubectl

# Trust Policy and Actor configuration paths
KUBEVYUHA_TRUST_POLICY=config/trust_policy.example.yaml
KUBEVYUHA_APPROVED_ACTORS=config/approved_actors.example.yaml

# Execution safeguard: Must explicitly set to "true" to allow execution
KUBEVYUHA_ALLOW_EXECUTION=false

# Report export directory
KUBEVYUHA_REPORT_DIR=reports
